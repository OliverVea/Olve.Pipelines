  "components": {
    "schemas": {
      "BindingDeployTrigger": {
        "type": "integer",
        "default": 0
      },
      "CreatePipelineWithRepoRequest": {
        "required": [
          "repo",
          "branch",
          "path",
          "credentialsSecret"
        ],
        "type": "object",
        "properties": {
          "repo": {
            "type": "string"
          },
          "branch": {
            "type": [
              "null",
              "string"
            ]
          },
          "path": {
            "type": [
              "null",
              "string"
            ]
          },
          "credentialsSecret": {
            "type": [
              "null",
              "string"
            ]
          },
          "deployTrigger": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/BindingDeployTrigger"
              }
            ]
          }
        }
      },
      "IdOfJob": {
        "type": "string",
        "format": "uuid"
      },
      "IdOfPipeline": {
        "type": "string",
        "format": "uuid"
      },
      "IdOfPipelineConfigBinding": {
        "type": "string",
        "format": "uuid"
      },
      "Job": {
        "required": [
          "id",
          "pipelineId",
          "stepName",
          "image",
          "script",
          "createdAt",
          "status"
        ],
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/IdOfJob"
          },
          "pipelineId": {
            "$ref": "#/components/schemas/IdOfPipeline"
          },
          "stepName": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "script": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "environmentVariables": {
            "type": [
              "null",
              "object"
            ],
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "JobSortField": {
        "type": "integer"
      },
      "JobStatus": {
        "required": [
          "type"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          }
        },
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "scheduled": "#/components/schemas/JobStatusScheduled",
            "in-progress": "#/components/schemas/JobStatusInProgress",
            "done": "#/components/schemas/JobStatusDone",
            "obsolete": "#/components/schemas/JobStatusObsolete",
            "cancelled": "#/components/schemas/JobStatusCancelled",
            "failed": "#/components/schemas/JobStatusFailed"
          }
        }
      },
      "JobStatusCancelled": {
        "required": [
          "startedAt",
          "cancelledAt"
        ],
        "allOf": [
          {
            "$ref": "#/components/schemas/JobStatus"
          }
        ],
        "properties": {
          "startedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "cancelledAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "JobStatusDone": {
        "required": [
          "startedAt",
          "completedAt"
        ],
        "allOf": [
          {
            "$ref": "#/components/schemas/JobStatus"
          }
        ],
        "properties": {
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "JobStatusFailed": {
        "required": [
          "startedAt",
          "failedAt"
        ],
        "allOf": [
          {
            "$ref": "#/components/schemas/JobStatus"
          }
        ],
        "properties": {
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "failedAt": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "JobStatusInProgress": {
        "required": [
          "startedAt"
        ],
        "allOf": [
          {
            "$ref": "#/components/schemas/JobStatus"
          }
        ],
        "properties": {
          "startedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "JobStatusObsolete": {
        "required": [
          "supersedingJobId"
        ],
        "allOf": [
          {
            "$ref": "#/components/schemas/JobStatus"
          }
        ],
        "properties": {
          "supersedingJobId": {
            "$ref": "#/components/schemas/IdOfJob"
          }
        }
      },
      "JobStatusScheduled": {
