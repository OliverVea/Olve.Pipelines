  "components": {
    "schemas": {
      "Attempt": {
        "required": [
          "id",
          "pipelineId",
          "runId",
          "runNumber",
          "stepName",
          "number",
          "status",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/IdOfAttempt"
          },
          "pipelineId": {
            "$ref": "#/components/schemas/IdOfPipeline"
          },
          "runId": {
            "$ref": "#/components/schemas/IdOfRun"
          },
          "runNumber": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": "integer",
            "format": "int32"
          },
          "stepName": {
            "type": "string"
          },
          "number": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "$ref": "#/components/schemas/AttemptStatus"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "inputHash": {
            "type": [
              "null",
              "string"
            ]
          },
          "output": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/AttemptOutput"
              }
            ]
          }
        }
      },
      "AttemptOutput": {
        "required": [
          "key",
          "json"
        ],
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "json": {
            "type": "string"
          }
        }
      },
      "AttemptSortField": {
        "type": "integer"
      },
      "AttemptStatus": {
        "required": [
          "type"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          }
        },
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "scheduled": "#/components/schemas/AttemptStatusScheduled",
            "in-progress": "#/components/schemas/AttemptStatusInProgress",
            "succeeded": "#/components/schemas/AttemptStatusSucceeded",
            "failed": "#/components/schemas/AttemptStatusFailed",
            "skipped": "#/components/schemas/AttemptStatusSkipped",
            "cancelled": "#/components/schemas/AttemptStatusCancelled",
