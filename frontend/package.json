{
  "name": "olve-pipelines-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:docs-index": "node scripts/build-docs-index.mjs",
    "predev": "node scripts/build-docs-index.mjs",
    "dev": "vite",
    "dev:prod": "vite --mode prod-api",
    "prebuild": "node scripts/build-docs-index.mjs",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.app.json",
    "preview": "vite preview",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "mocks": "sirv ../docs/mocks --dev --port 4173 --host"
  },
  "dependencies": {
    "@microsoft/kiota-abstractions": "^1.0.0-preview.100",
    "@microsoft/kiota-bundle": "^1.0.0-preview.100",
    "@microsoft/kiota-http-fetchlibrary": "^1.0.0-preview.100",
    "@olve/olve-pipelines-client": "file:../clients/olve-pipelines-client-ts",
    "ansi_up": "^6.0.6",
    "dompurify": "^3.4.11",
    "lit": "^3.2.0",
    "marked": "^18.0.5",
    "minisearch": "^7.2.0",
    "oidc-client-ts": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.5.0",
    "sirv-cli": "^3.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.1"
  }
}
