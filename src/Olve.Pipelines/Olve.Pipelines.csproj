<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <OpenApiDocumentsDirectory>$(MSBuildThisFileDirectory)..\..\</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name api</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Olve.Pipelines.UnitTests" />
  </ItemGroup>

  <!-- Serve the setup guide (docs/setup/*.md) at /docs. Copied into wwwroot so a local
       `dotnet run` serves them too; the Dockerfile copies the same files for the container. -->
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)..\..\docs\setup\**\*.md"
             Link="wwwroot\docs\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Duende.IdentityModel" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="Olve.MinimalApi" />
    <PackageReference Include="Olve.Results" />
    <PackageReference Include="Olve.Validation" />
    <PackageReference Include="Olve.Utilities" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

</Project>
