<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The CLI apphost is named 'pl'; without this, the testing platform's Polish ('pl')
         satellite-resource folder collides with it on copy. Keep English resources only. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Olve.Results.TUnit" />
    <PackageReference Include="Rocks" />
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <!-- self-deploy.manifest.json: `olve-dev describe src/sdk/examples/self-deploy` output, byte-for-byte. -->
    <None Include="Manifests/Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The contract suites run here against the fakes and in the real-system tests against the real systems. -->
  <ItemGroup>
    <Compile Include="../Olve.Pipelines.RealSystemTests/Contracts/*.cs" LinkBase="RealSystem/Contracts" />
    <Compile Include="../Olve.Pipelines.RealSystemTests/Hosting/ServerPool.cs;../Olve.Pipelines.RealSystemTests/Hosting/TargetGuard.cs;../Olve.Pipelines.RealSystemTests/Hosting/TestTargets.cs;../Olve.Pipelines.RealSystemTests/Hosting/Wait.cs" LinkBase="RealSystem/Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Olve.Pipelines/Olve.Pipelines.csproj" />
  </ItemGroup>

</Project>
