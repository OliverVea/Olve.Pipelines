<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Olve.Pipelines.UnitTests" />
  </ItemGroup>

  <!-- The API surface generated from the contract (src/spec/main.tsp, docs/design/spec-first.md) and the
       OpenAPI document it serves at /docs/openapi.json; -p:SkipSpecGen=true compiles already-emitted
       files without bun (the deploy's spec step emits them). -->
  <PropertyGroup>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../'))</RepoRoot>
  </PropertyGroup>

  <ItemGroup>
    <TypeSpecContract Include="$(RepoRoot)src/spec/main.tsp" GeneratedDir="$(RepoRoot)artifacts/generated/backend/" />
  </ItemGroup>

  <!-- Serve the setup guide (docs/setup/*.md) at /docs. Copied into wwwroot so a local
       `dotnet run` serves them too; the Dockerfile copies the same files for the container. -->
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)..\..\..\docs\setup\**\*.md"
             Link="wwwroot\docs\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <!-- The contract's OpenAPI document (GenerateApi above), not committed. -->
    <Content Include="$(RepoRoot)artifacts/spec/openapi.json"
             Link="wwwroot\docs\openapi.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <!-- llms.txt is the agent-discovery entry point: served at the site root (/llms.txt),
         it points crawlers/agents at the raw /docs/*.md pages without a repo clone. -->
    <Content Include="$(MSBuildThisFileDirectory)..\..\..\docs\setup\llms.txt"
             Link="wwwroot\llms.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <!-- The pl install scripts, served at /install.sh and /install.ps1 with this instance as their
         default (Distribution/CliDistribution.cs). Next to the binary, not in wwwroot: they are
         rewritten per request, never served raw. -->
    <Content Include="$(MSBuildThisFileDirectory)..\..\..\install.sh;$(MSBuildThisFileDirectory)..\..\..\install.ps1"
             Link="%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Duende.IdentityModel" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="Olve.MinimalApi" />
    <PackageReference Include="Olve.Results" />
    <PackageReference Include="Olve.TypeSpec" />
    <PackageReference Include="Olve.Validation" />
    <PackageReference Include="Olve.Utilities" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <!-- Only its event parser (YamlDotNet.Core), which is reflection-free: config documents → JsonNode. -->
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

</Project>
