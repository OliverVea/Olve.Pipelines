{
  "name": "olve-pipelines-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:docs-index": "node scripts/build-docs-index.mjs",
    "predev": "node scripts/build-docs-index.mjs",
    "dev": "vite",
    "dev:prod": "vite --mode prod-api",
    "dev:beta": "vite --mode beta",
    "prebuild": "node scripts/build-docs-index.mjs",
    "build": "tsc -p tsconfig.app.json && vite build",
    "typecheck": "tsc -p tsconfig.app.json",
    "preview": "vite preview",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "ansi_up": "^6.0.6",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.11",
    "lit": "^3.2.0",
    "marked": "^18.0.5",
    "minisearch": "^7.2.0",
    "oidc-client-ts": "^3.5.0",
    "redoc": "^3.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.1"
  }
}
