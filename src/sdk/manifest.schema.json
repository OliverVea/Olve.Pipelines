{
  "$defs": {
    "InputType": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "cells": {
              "const": true,
              "description": "cells(Model): every cell of a matrix step whose output is the model, mapped with a whole-step ref; the value is [{cell, output}, …] in cell order. Omitted otherwise.",
              "type": "boolean"
            },
            "model": {
              "description": "Model name (key of `models`).",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
              "type": "string"
            },
            "optional": {
              "description": "optional(Model): may be absent because its producer was skipped.",
              "type": "boolean"
            }
          },
          "required": [
            "model",
            "optional"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "schema": {
              "$ref": "#/$defs/ModelSchemas",
              "description": "A plain (unnamed) zod schema. Such inputs always have an explicit mapping."
            }
          },
          "required": [
            "schema"
          ],
          "type": "object"
        }
      ]
    },
    "Json": {
      "$ref": "#/$defs/__schema0",
      "description": "Any JSON value."
    },
    "Manifest": {
      "additionalProperties": false,
      "properties": {
        "apiVersion": {
          "const": "2.0",
          "type": "string"
        },
        "codeHash": {
          "description": "Hash of the whole build: the pipeline and its code bundled, plus the harness. Any code change makes a new pipeline version.",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "config": {
          "description": "Config entries used by steps, sorted by name (omitted when none). Fields of kind secretRef ({secret: NAME}) name a secret.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "description": {
                "type": "string"
              },
              "name": {
                "description": "Config entry name; a key of the pipeline's config document.",
                "pattern": "^[a-z][a-zA-Z0-9]*$",
                "type": "string"
              },
              "required": {
                "description": "False when the schema accepts a missing value (optional, or a default).",
                "type": "boolean"
              },
              "schema": {
                "additionalProperties": {},
                "description": "z.input view: validates the config document's value for this entry (defaults listed).",
                "propertyNames": {
                  "type": "string"
                },
                "type": "object"
              }
            },
            "required": [
              "name",
              "description",
              "required",
              "schema"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "description": {
          "type": "string"
        },
        "failureHandlers": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "step": {
                "$ref": "#/$defs/Step",
                "description": "The handler step. Not part of any stage; its inputs are all FailureContext ({ref: 'failure'})."
              },
              "steps": {
                "anyOf": [
                  {
                    "items": {
                      "description": "Step name: lower-case kebab, 1-63 chars. The step's identity.",
                      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
                      "type": "string"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Steps whose failure triggers the handler (null = any step)."
              }
            },
            "required": [
              "step",
              "steps"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "harness": {
          "additionalProperties": false,
          "description": "Harness identity. Already folded into codeHash.",
          "properties": {
            "bun": {
              "description": "Bun runtime version compiled into the binary.",
              "type": "string"
            },
            "sdk": {
              "description": "@olivervea/pipelines package version.",
              "type": "string"
            },
            "sdkHash": {
              "description": "Hash of the SDK runtime sources + zod version.",
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "bun",
            "sdk",
            "sdkHash"
          ],
          "type": "object"
        },
        "input": {
          "description": "Pipeline input model.",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "type": "string"
        },
        "models": {
          "additionalProperties": {
            "$ref": "#/$defs/ModelSchemas"
          },
          "description": "Every model referenced by the pipeline (input, step inputs/outputs).",
          "propertyNames": {
            "description": "Model name (key of `models`).",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
            "type": "string"
          },
          "type": "object"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "retention": {
          "additionalProperties": false,
          "description": "Retention overrides for this pipeline (omitted when none). Each field replaces the instance setting of the same meaning.",
          "properties": {
            "buildGraceDays": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "keepLatestRuns": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "minRunAgeDays": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "secrets": {
          "description": "All declared secrets (steps + poll triggers), sorted by name.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "description": {
                "type": "string"
              },
              "name": {
                "description": "Secret name; also the env var name in the step container.",
                "pattern": "^[A-Z_][A-Z0-9_]*$",
                "type": "string"
              }
            },
            "required": [
              "name",
              "description"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "stages": {
          "items": {
            "$ref": "#/$defs/Stage"
          },
          "type": "array"
        },
        "triggers": {
          "items": {
            "$ref": "#/$defs/Trigger"
          },
          "type": "array"
        }
      },
      "required": [
        "apiVersion",
        "name",
        "input",
        "harness",
        "codeHash",
        "models",
        "secrets",
        "triggers",
        "stages",
        "failureHandlers"
      ],
      "title": "Olve.Pipelines v2 manifest",
      "type": "object"
    },
    "Mapping": {
      "anyOf": [
        {
          "additionalProperties": false,
          "description": "Value taken from the run pool. A ref whose root step was skipped yields no value (only allowed for optional inputs).",
          "properties": {
            "ref": {
              "description": "'<root>' or '<root>.<field>.<field>…'. Root: 'input' (pipeline input), a step name (that step's output) or 'failure' (FailureContext, failure handlers only).",
              "pattern": "^(?:input|failure|[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)(?:\\.[^.]+)*$",
              "type": "string"
            }
          },
          "required": [
            "ref"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A JSON constant.",
          "properties": {
            "const": {
              "$ref": "#/$defs/Json"
            }
          },
          "required": [
            "const"
          ],
          "type": "object"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/Mapping"
          },
          "description": "An object built field by field. Discrimination: an object whose only key is 'ref' (string value) is a ref, whose only key is 'const' is a constant, anything else is a nested object (describe never emits a nested object whose only key is 'ref' or 'const').",
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        }
      ]
    },
    "Matrix": {
      "additionalProperties": false,
      "description": "A matrix step runs once per cell, named '<step>[<axis>=<value>,…]' in axis order; OLVE_CELL holds the cell as compact JSON.",
      "properties": {
        "axes": {
          "description": "In order: the cells are the cross product, first axis outermost, minus the excludes (1 to 64 cells).",
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "pattern": "^[a-z][a-zA-Z0-9]{0,30}$",
                "type": "string"
              },
              "values": {
                "description": "Unique per axis.",
                "items": {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$",
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              }
            },
            "required": [
              "name",
              "values"
            ],
            "type": "object"
          },
          "maxItems": 4,
          "minItems": 1,
          "type": "array"
        },
        "exclude": {
          "description": "Each entry names one or more axes with one of their values; a cell matching every named axis is left out (omitted when none).",
          "items": {
            "additionalProperties": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$",
              "type": "string"
            },
            "propertyNames": {
              "pattern": "^[a-z][a-zA-Z0-9]{0,30}$",
              "type": "string"
            },
            "type": "object"
          },
          "type": "array"
        },
        "failure": {
          "additionalProperties": false,
          "description": "keepRunning: every cell runs to the end. cascadeFailure: a cell whose last allowed attempt failed cancels the step's other scheduled or running cells.",
          "properties": {
            "kind": {
              "enum": [
                "keepRunning",
                "cascadeFailure"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        "maxParallel": {
          "description": "At most this many of the step's cells running at once in a run.",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "axes",
        "failure"
      ],
      "type": "object"
    },
    "ModelSchemas": {
      "additionalProperties": false,
      "properties": {
        "input": {
          "additionalProperties": {},
          "description": "z.input view (defaults make fields optional; `default` values are listed). Present only when it differs from `output`.",
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        },
        "output": {
          "additionalProperties": {},
          "description": "z.output view: validates step outputs, trigger results and the pool. Every object has additionalProperties: false.",
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "required": [
        "output"
      ],
      "type": "object"
    },
    "Stage": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "steps": {
              "description": "Steps run in parallel; the stage is a barrier.",
              "items": {
                "$ref": "#/$defs/Step"
              },
              "minItems": 1,
              "type": "array"
            }
          },
          "required": [
            "steps"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "stages": {
              "items": {
                "$ref": "#/$defs/Stage"
              },
              "type": "array"
            },
            "when": {
              "additionalProperties": {
                "items": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "minItems": 1,
                "type": "array"
              },
              "description": "Pipeline-input field → accepted values (all fields must match). Empty object = always.",
              "propertyNames": {
                "type": "string"
              },
              "type": "object"
            }
          },
          "required": [
            "when",
            "stages"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "cases": {
              "additionalProperties": {
                "items": {
                  "$ref": "#/$defs/Stage"
                },
                "type": "array"
              },
              "description": "Discriminator value → stages. Exactly one case runs; a step name may repeat across cases, nowhere else.",
              "propertyNames": {
                "type": "string"
              },
              "type": "object"
            },
            "discriminator": {
              "description": "The union's literal field whose value names the case.",
              "minLength": 1,
              "type": "string"
            },
            "select": {
              "description": "Config reference (`<entry>.<field>…`) to a discriminated union; the run's config snapshot picks the case.",
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "select",
            "discriminator",
            "cases"
          ],
          "type": "object"
        }
      ]
    },
    "Step": {
      "additionalProperties": false,
      "properties": {
        "clusterAccess": {
          "const": true,
          "description": "The step pod gets the instance's step ServiceAccount token (Kubernetes:StepServiceAccount), if the instance grants one. Omitted = no token.",
          "type": "boolean"
        },
        "config": {
          "additionalProperties": {
            "$ref": "#/$defs/Json"
          },
          "description": "The step's settings (display only). A config reference is recorded as {\"$config\": \"<entry>.<field>…\"}; the entry is in configEntries.",
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        },
        "configEntries": {
          "description": "Config entries the step receives (sorted; omitted when none). The service delivers them in input.json under '$config'.",
          "items": {
            "description": "Config entry name; a key of the pipeline's config document.",
            "pattern": "^[a-z][a-zA-Z0-9]*$",
            "type": "string"
          },
          "type": "array"
        },
        "description": {
          "description": "What the step does, shown in the UI (may be empty).",
          "type": "string"
        },
        "externalInputs": {
          "additionalProperties": {
            "additionalProperties": false,
            "properties": {
              "description": {
                "type": "string"
              },
              "from": {
                "description": "Who or what may answer.",
                "items": {
                  "oneOf": [
                    {
                      "additionalProperties": false,
                      "properties": {
                        "kind": {
                          "const": "person",
                          "type": "string"
                        }
                      },
                      "required": [
                        "kind"
                      ],
                      "type": "object"
                    },
                    {
                      "additionalProperties": false,
                      "properties": {
                        "kind": {
                          "const": "callback",
                          "type": "string"
                        }
                      },
                      "required": [
                        "kind"
                      ],
                      "type": "object"
                    },
                    {
                      "additionalProperties": false,
                      "properties": {
                        "intervalSeconds": {
                          "maximum": 9007199254740991,
                          "minimum": 10,
                          "type": "integer"
                        },
                        "kind": {
                          "const": "poll",
                          "type": "string"
                        },
                        "url": {
                          "description": "GET while waiting; {run.id} and {run.number} are filled in.",
                          "type": "string"
                        },
                        "valuePath": {
                          "description": "Dot path to the value; '.' is the whole body.",
                          "minLength": 1,
                          "type": "string"
                        }
                      },
                      "required": [
                        "kind",
                        "url",
                        "valuePath",
                        "intervalSeconds"
                      ],
                      "type": "object"
                    }
                  ]
                },
                "minItems": 1,
                "type": "array"
              },
              "link": {
                "additionalProperties": false,
                "description": "The link shown while the step waits: the absolute http(s) URL at 'path' inside the value of the step's input 'input'. Omitted when none.",
                "properties": {
                  "input": {
                    "description": "One of the same step's inputs (not an external one).",
                    "minLength": 1,
                    "type": "string"
                  },
                  "label": {
                    "description": "Default: the input's title.",
                    "maxLength": 100,
                    "minLength": 1,
                    "type": "string"
                  },
                  "path": {
                    "description": "Dot path inside that input's value; omitted = the value itself is the URL.",
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "input"
                ],
                "type": "object"
              },
              "model": {
                "description": "The value is validated against this model's input view.",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
                "type": "string"
              },
              "title": {
                "description": "What is asked, shown to whoever answers.",
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "model",
              "title",
              "description",
              "from"
            ],
            "type": "object"
          },
          "description": "Inputs answered from outside the run (omitted when none): the step waits until every one has a value, which the service writes into input.json under its key.",
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        },
        "image": {
          "description": "Container image the step runs in.",
          "minLength": 1,
          "type": "string"
        },
        "input": {
          "additionalProperties": {
            "$ref": "#/$defs/Mapping"
          },
          "description": "How the service assembles input.json: one mapping per input key (same keys as inputTypes).",
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        },
        "inputTypes": {
          "additionalProperties": {
            "$ref": "#/$defs/InputType"
          },
          "description": "Declared input entries, keyed like input.json.",
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        },
        "kind": {
          "description": "A label for the step's kind: 'custom' unless the step names one.",
          "minLength": 1,
          "type": "string"
        },
        "matrix": {
          "$ref": "#/$defs/Matrix",
          "description": "Set on a matrix step (never on a failure handler); omitted otherwise."
        },
        "name": {
          "description": "Step name: lower-case kebab, 1-63 chars. The step's identity.",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "type": "string"
        },
        "output": {
          "anyOf": [
            {
              "description": "Model name (key of `models`).",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Output model, or null if the step produces no output."
        },
        "preflight": {
          "const": true,
          "description": "The step runs its preflight (the harness's 'preflight <step>' mode, on the step's non-external inputs) before it waits for its external inputs; only a step with external inputs has one. Omitted = none.",
          "type": "boolean"
        },
        "retries": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "secrets": {
          "description": "Declared secrets (sorted). Mount exactly these, as env vars of the same name.",
          "items": {
            "description": "Secret name; also the env var name in the step container.",
            "pattern": "^[A-Z_][A-Z0-9_]*$",
            "type": "string"
          },
          "type": "array"
        },
        "timeoutSeconds": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "description",
        "kind",
        "image",
        "inputTypes",
        "input",
        "output",
        "secrets"
      ],
      "type": "object"
    },
    "Trigger": {
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "GitHub push. Event = the webhook payload.",
          "properties": {
            "kind": {
              "const": "push",
              "type": "string"
            },
            "name": {
              "const": "push",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Background poller.",
          "properties": {
            "headers": {
              "additionalProperties": {
                "type": "string"
              },
              "description": "Values may contain '$SECRET:NAME' (NAME ∈ secrets).",
              "propertyNames": {
                "type": "string"
              },
              "type": "object"
            },
            "intervalSeconds": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "kind": {
              "const": "poll",
              "type": "string"
            },
            "name": {
              "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
              "type": "string"
            },
            "secrets": {
              "items": {
                "description": "Secret name; also the env var name in the step container.",
                "pattern": "^[A-Z_][A-Z0-9_]*$",
                "type": "string"
              },
              "type": "array"
            },
            "url": {
              "type": "string"
            },
            "valuePath": {
              "description": "Dot path into the JSON response; a change triggers map-trigger with {\"value\": <string>}.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name",
            "url",
            "headers",
            "secrets",
            "valuePath",
            "intervalSeconds"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Inbound HTTP delivery to /api/hooks/<pipeline id>/<name>. Event = {headers, body}; a null mapping ignores it.",
          "properties": {
            "kind": {
              "const": "webhook",
              "type": "string"
            },
            "name": {
              "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
              "type": "string"
            },
            "verify": {
              "oneOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "header": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "prefix": {
                      "description": "Text before the hex digest in the header, e.g. 'sha256='.",
                      "type": "string"
                    },
                    "scheme": {
                      "const": "hmac-sha256",
                      "type": "string"
                    },
                    "secret": {
                      "description": "Secret name; also the env var name in the step container.",
                      "pattern": "^[A-Z_][A-Z0-9_]*$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "scheme",
                    "secret",
                    "header",
                    "prefix"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "scheme": {
                      "const": "bearer",
                      "type": "string"
                    },
                    "secret": {
                      "description": "Secret name; also the env var name in the step container.",
                      "pattern": "^[A-Z_][A-Z0-9_]*$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "scheme",
                    "secret"
                  ],
                  "type": "object"
                }
              ]
            }
          },
          "required": [
            "kind",
            "name",
            "verify"
          ],
          "type": "object"
        }
      ]
    },
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "items": {
            "$ref": "#/$defs/__schema0"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        }
      ]
    }
  },
  "$id": "https://olve.dev/schemas/pipelines/manifest-2.0.json",
  "$ref": "#/$defs/Manifest",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
