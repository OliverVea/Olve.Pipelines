{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": ["bun"],
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@olivervea/pipelines": ["./src/index.ts"],
      "@olivervea/pipelines/harness": ["./src/harness/index.ts"],
      "@olivervea/pipelines/testing": ["./src/testing/index.ts"]
    }
  },
  "include": ["src", "tests", "examples", "scripts"],
  "exclude": ["tests/.tmp", "**/.olve", "dist", "gen", "node_modules"]
}
