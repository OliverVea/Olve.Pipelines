            "required": [
              "id",
              "name"
            ],
            "type": "object"
          },
          "reason": {
            "type": "string"
          },
          "run": {
            "additionalProperties": false,
            "properties": {
              "address": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "number": {
                "maximum": 9007199254740991,
                "minimum": -9007199254740991,
                "type": "integer"
              },
              "trigger": {
                "enum": [
                  "push",
                  "poll",
                  "manual"
                ],
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "versionStamp": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "number",
              "address",
              "versionStamp",
              "trigger",
              "url"
            ],
            "type": "object"
          },
          "version": {
            "additionalProperties": false,
            "properties": {
              "commit": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "number": {
                "maximum": 9007199254740991,
                "minimum": -9007199254740991,
                "type": "integer"
              }
            },
            "required": [
              "number",
              "commit"
            ],
            "type": "object"
          }
        },
        "required": [
          "pipeline",
          "run",
          "version",
          "input",
          "reason",
          "failedSteps"
        ],
        "type": "object"
      }
    },
    "Greeting": {
      "output": {
        "additionalProperties": false,
        "properties": {
          "file": {
            "additionalProperties": false,
            "properties": {
              "attempt": {
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
              },
              "path": {
                "pattern": "^(?:(?!\\.\\.?(?:\\/|$))[^/\\\\\\x00]+\\/)*(?!\\.\\.?(?:\\/|$))[^/\\\\\\x00]+\\/?$",
                "type": "string"
              },
              "run": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              },
              "sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "step": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "run",
              "step",
              "attempt",
              "path",
              "sha256"
            ],
            "type": "object",
            "x-olve-kind": "fileRef"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message",
          "file"
        ],
        "type": "object"
      }
    },
    "LineCount": {
      "output": {
        "additionalProperties": false,
        "properties": {
          "lines": {
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          }
        },
        "required": [
          "lines"
        ],
        "type": "object"
      }
    },
    "Summary": {
      "output": {
        "additionalProperties": false,
        "properties": {
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "summary"
        ],
        "type": "object"
      }
    },
    "TestInput": {
      "input": {
        "properties": {
          "mode": {
            "default": "normal",
            "enum": [
              "normal",
              "skip-last",
              "fail"
            ],
            "type": "string"
          },
          "sha": {
            "pattern": "^[0-9a-f]{7,40}$",
            "type": "string"
          }
        },
        "required": [
          "sha"
        ],
        "type": "object"
      },
      "output": {
        "additionalProperties": false,
        "properties": {
          "mode": {
            "default": "normal",
            "enum": [
              "normal",
              "skip-last",
              "fail"
            ],
            "type": "string"
          },
          "sha": {
            "pattern": "^[0-9a-f]{7,40}$",
            "type": "string"
          }
        },
        "required": [
          "sha",
          "mode"
        ],
        "type": "object"
      }
    }
  },
